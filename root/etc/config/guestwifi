config config 'config'
	option enabled '0'
	option mode 'schedule'
	# mode: always | schedule | off
	# Подсети интерфейсов гостевого Wi-Fi (создаются uci-defaults)
	list wifi 'guestg'
	list wifi 'guesta'
	# Расписание работы сети: '<дни>|<HH:MM>|<HH:MM>'  дни: 1..7 (1=Пн,7=Вс) или '*'
	list schedule '1,2,3,4,5|08:00|23:30'
	list schedule '6,7|10:00|23:59'
	# Авто-смена SSID: '<указанное имя>_<текущая дата>', смена происходит
	# автоматически при смене даты
	option ssid_schedule '1'
	option ssid_base 'Guest'
