#!/bin/sh
# guestwifi - backend for luci-app-guestwifi
# Usage: guestwifi check|status|on|off|help

CFG="guestwifi"
CONFFILE="/etc/config/$CFG"
STATE="/var/run/guestwifi.state"
STATUS="/var/run/guestwifi.json"

log() { logger -t guestwifi "$1"; }

uciget() { uci -q get "$1"; }

# list_get OPTION -> prints each list element on its own line.
# Reads the raw config file because `uci get` returns all elements
# space-joined with quoting, which breaks tokens containing spaces.
list_get() {
	sed -n "s/^[ 	]*list[ 	]*$1[ 	]*//p" "$CONFFILE" |
	sed -e "s/^['\"]//" -e "s/['\"][ 	]*$//"
}

# --- helpers -----------------------------------------------------------

# day number 1..7 (1=Mon .. 7=Sun)
daynum() {
	local w
	w=$(date +%w)
	[ "$w" = "0" ] && w=7
	echo "$w"
}

# decimal int from "08"-style string (busybox ash lacks base# literals)
dec10() {
	local n="$1"
	while [ "${#n}" -gt 1 ] && [ "${n#0}" != "$n" ]; do
		n=${n#0}
	done
	echo "$n"
}

# minutes since midnight
nowmin() {
	local h m
	h=$(date +%H); m=$(date +%M)
	echo $(( $(dec10 "$h") * 60 + $(dec10 "$m") ))
}

# day_match DAYS DAYNUM -> echoes 1 on match (0 otherwise)
# DAYS: '*', '1,3,5' and/or ranges '1-4' (1=Mon..7=Sun)
day_match() {
	local days="$1" d="$2" bit=0 part a b
	[ "$days" = "*" ] && { echo 1; return; }
	for part in $(echo "$days" | tr ',' ' '); do
		case "$part" in
			*-*)
				a=$(dec10 "${part%%-*}"); b=$(dec10 "${part##*-}")
				[ "$d" -ge "$a" ] 2>/dev/null && [ "$d" -le "$b" ] 2>/dev/null && bit=1
				;;
			*[!0-9]*) ;;
			*) [ "$d" = "$part" ] && bit=1 ;;
		esac
	done
	echo "$bit"
}

# window_match DAYS START END: START/END "HH:MM"; window matches day of START
# (windows may cross midnight; [start, end) semantics)
window_match() {
	local days="$1" s="$2" e="$3" sm em m
	m=$(nowmin)
	sm=$(( $(dec10 "${s%%:*}") * 60 + $(dec10 "${s##*:}") ))
	em=$(( $(dec10 "${e%%:*}") * 60 + $(dec10 "${e##*:}") ))
	[ "$(day_match "$days" "$(daynum)")" = "1" ] || { echo 0; return; }
	if [ "$em" -gt "$sm" ]; then
		[ "$m" -ge "$sm" ] && [ "$m" -lt "$em" ] && { echo 1; return; }
	else
		[ "$m" -ge "$sm" ] && { echo 1; return; }
		[ "$m" -lt "$em" ] && { echo 1; return; }
	fi
	echo 0
}

# -----------------------------------------------------------------------

wifi_ifaces() {
	list_get wifi
}

is_on() {
	local i d
	for i in $(wifi_ifaces); do
		d=$(uciget "wireless.$i.disabled")
		[ "$d" != "1" ] && { echo 1; return; }
	done
	echo 0
}

schedule_on() {
	local tok days s e rest r
	r=$(list_get schedule | while IFS=' ' read -r tok; do
		[ -n "$tok" ] || continue
		days=${tok%%|*}
		rest=${tok#*|}
		s=${rest%%|*}; e=${rest##*|}
		[ -n "$days" ] && [ -n "$s" ] && [ "$e" != "$tok" ] || continue
		case "$(window_match "$days" "$s" "$e")" in
			1) echo 1; return ;;
		esac
	done)
	[ "$r" = "1" ] && { echo 1; return; }
	echo 0
}

desired_ssid() {
	# SSID = <указанное имя>_<текущая дата>; переименовывается автоматически
	# при смене даты (check запускается cron'ом каждую минуту)
	[ "$(uciget "$CFG.config.ssid_schedule")" = "1" ] || { echo ""; return; }
	local base
	base=$(uciget "$CFG.config.ssid_base")
	echo "${base}_$(date +%d.%m.%Y)"
}

# --- bandwidth limiting ------------------------------------------------

tcpath() {
	command -v tc 2>/dev/null || echo /sbin/tc
}

# guest wifi kernel interfaces: ports of br-guest (e.g. phy0-ap1, phy1-ap1)
bridge_members() {
	ip -o link show 2>/dev/null | awk -F': ' '/master br-guest/ {print $2}'
}

bg_rate() {
	case "${1:-}" in *[!0-9]*|"") echo 0 ;; *) local n; n=$(dec10 "$1"); echo ${n:-0} ;; esac
}

shaper_running() {
	local TC dev
	TC="$(tcpath)"
	[ -n "$TC" ] && [ -x "$TC" ] || return 1
	for dev in $(bridge_members); do
		"$TC" qdisc show dev "$dev" root 2>/dev/null | grep -q htb && return 0
	done
	return 1
}

# сетевой префикс гостевой подсети: '192.168.9.1' -> '192.168.9.'
guest_prefix() {
	local ip
	ip=$(uciget network.guest.ipaddr)
	echo "$ip" | sed -n 's/^\([0-9]*\.[0-9]*\.[0-9]*\.\).*/\1/p'
}

# активные IP клиентов гостевой сети из DHCP-аренды
guest_leases() {
	local p
	p=$(guest_prefix)
	[ -n "$p" ] || return 0
	awk -v P="$p" '{ if (substr($3,1,length(P)) == P) print $3 }' \
		/tmp/dhcp.leases 2>/dev/null | sort -u
}

# сигнатура настроек шейдера + списка клиентов (для пересборки при изменениях)
shaper_sig() {
	echo "$(uciget "$CFG.config.limit_down")|$(uciget "$CFG.config.limit_up")|$(uciget "$CFG.config.limit_per")|$(guest_leases | tr '\n' ',')"
}

shaper_apply() {
	local TC down up per dev
	TC="$(tcpath)"
	[ -n "$TC" ] && [ -x "$TC" ] || { log "tc не найден — ограничение скорости пропущено"; return 0; }

	down=$(bg_rate "$(uciget "$CFG.config.limit_down")")
	up=$(bg_rate "$(uciget "$CFG.config.limit_up")")
	per=$(bg_rate "$(uciget "$CFG.config.limit_per")")

	modprobe sch_htb 2>/dev/null
	modprobe sch_ingress 2>/dev/null
	modprobe act_police 2>/dev/null
	modprobe cls_matchall 2>/dev/null
	modprobe cls_u32 2>/dev/null

	local ips total n
	ips=$(guest_leases)

	# пересборка с нуля: классы/фильтры зависят от списка клиентов
	for dev in $(bridge_members); do
		[ -d "/sys/class/net/$dev" ] || continue
		$TC qdisc del dev "$dev" root 2>/dev/null
		$TC qdisc del dev "$dev" ingress 2>/dev/null

		# egress = трафик к гостям (скачивание)
		if [ "$down" -gt 0 ] || [ "$per" -gt 0 ]; then
			total="$down"
			[ "$total" -eq 0 ] && total=100000
			$TC qdisc add dev "$dev" root handle 1: htb default 10 2>/dev/null
			$TC class add dev "$dev" parent 1: classid 1:10 htb rate "${total}kbit" ceil "${total}kbit" 2>/dev/null
		fi

		n=0
		if [ "$per" -gt 0 ]; then
			# личный класс каждому клиенту; прочие IP → общий класс 1:10
			local ip
			for ip in $ips; do
				n=$((n+1))
				$TC class add dev "$dev" parent 1: classid "1:$(printf '%x' $((n+19)))" \
					htb rate "${per}kbit" ceil "${total}kbit" 2>/dev/null
				$TC filter add dev "$dev" protocol ip parent 1: prio $n \
					u32 match ip dst "$ip/32" flowid "1:$(printf '%x' $((n+19)))" 2>/dev/null
			done
		fi

		if [ "$up" -gt 0 ] || [ "$per" -gt 0 ]; then
			$TC qdisc add dev "$dev" ingress 2>/dev/null
		fi

		# ingress = трафик от гостей (отдача)
		if [ "$per" -gt 0 ] && [ -n "$ips" ]; then
			n=0
			local ip
			for ip in $ips; do
				n=$((n+1))
				$TC filter add dev "$dev" protocol ip parent ffff: prio $n \
					u32 match ip src "$ip/32" police rate "${per}kbit" burst 512k \
					conform-exceed drop 2>/dev/null
			done
		elif [ "$up" -gt 0 ]; then
			$TC filter add dev "$dev" parent ffff: protocol all pref 49152 \
				matchall action police rate "${up}kbit" burst 512k \
				conform-exceed drop 2>/dev/null
		fi
	done
}

shaper_clear() {
	local TC dev
	TC="$(tcpath)"
	[ -n "$TC" ] && [ -x "$TC" ] || return 0
	for dev in $(bridge_members); do
		[ -d "/sys/class/net/$dev" ] || continue
		$TC qdisc del dev "$dev" root 2>/dev/null
		$TC qdisc del dev "$dev" ingress 2>/dev/null
	done
}

# --- firewall: guests' access to the router itself ----------------------

# section id of firewall zone named $1 (e.g. @zone[2])
guest_zone_id() {
	uci show firewall 2>/dev/null |
		sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='$1'$/\1/p"
}

fw_sync() {
	local block want cur z
	z=$(guest_zone_id guest)
	[ -n "$z" ] || return 0

	block=$(uciget "$CFG.config.fw_block_router")
	[ "$block" = "1" ] && want=REJECT || want=ACCEPT

	cur=$(uciget "firewall.$z.input")
	cur=${cur:-ACCEPT}
	if [ "$cur" != "$want" ]; then
		uci set "firewall.$z.input=$want"
		uci commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1 || fw4 reload >/dev/null 2>&1
		log "firewall: гостевая зона input=$want"
	fi
}


apply_state() {
	# $1 = 0|1 (on/off desired), $2 = ssid or ""
	local want="$1" ssid="$2" i d net_enabled=0 dirty=0
	[ "$want" = "1" ] && net_enabled=1

	for i in $(wifi_ifaces); do
		[ -n "$(uciget "wireless.$i")" ] || continue
		d=$(uciget "wireless.$i.disabled")
		local newd=$(( 1 - net_enabled ))
		if [ "$d" != "$newd" ]; then
			uci set "wireless.$i.disabled=$newd"
			dirty=1
		fi
		if [ "$net_enabled" = "1" ] && [ -n "$ssid" ]; then
			local cur=$(uciget "wireless.$i.ssid")
			if [ "$cur" != "$ssid" ]; then
				uci set "wireless.$i.ssid=$ssid"
				dirty=1
				log "SSID on '$i' -> '$ssid'"
			fi
		fi
	done

	if [ "$dirty" = "1" ]; then
		uci commit wireless
		wifi reconf >/dev/null 2>&1 || wifi up >/dev/null 2>&1 || wifi reload >/dev/null 2>&1
		log "wireless reloaded"
	fi
}

write_status() {
	local on="$1" want="$2" clients="$3" ts i cur
	ts=$(date +%s)
	{
		echo -n "{\"now\":$ts,\"state\":\"$on\",\"expected\":\"$want\","
		[ -n "$clients" ] && echo -n "\"clients\":$clients,"
		first=1
		for i in $(wifi_ifaces); do
			cur=$(uciget "wireless.$i.ssid")
			d=$(uciget "wireless.$i.disabled")
			[ "$first" = "1" ] && first=0 || echo -n ","
			echo -n "\"$i\":{\"ssid\":\"$(printf '%s' "$cur" | json_quote)\""
			echo -n ",\"up\":$([ "$d" != "1" ] && echo true || echo false)}"
		done
		echo "}"
	} > "$STATUS" 2>/dev/null
}

json_quote() {
	sed "s/\\\\/\\\\\\\\/g; s/\"/\\\\\"/g"
}

do_check() {
	local enabled want ssid
	enabled=$(uciget "$CFG.config.enabled")
	[ "$enabled" = "1" ] || enabled=0

	want=0
	if [ "$enabled" = "1" ]; then
		case "$(uciget "$CFG.config.mode")" in
			always)  want=1 ;;
			off)     want=0 ;;
			*)       want=$(schedule_on) ;;
		esac
	fi

	ssid=""
	if [ "$want" = "1" ] && [ "$(uciget "$CFG.config.ssid_schedule")" = "1" ]; then
		ssid=$(desired_ssid)
	fi

	local cur_on="$(is_on)"
	local last_ssid=$(sed -n 's/^ssid=//p' "$STATE" 2>/dev/null)
	if [ "$cur_on" != "$want" ] || [ "$ssid" != "$last_ssid" ]; then
		apply_state "$want" "$ssid"
		cur_on="$(is_on)"
	fi

	# скорость: полоса ограничивается только у активной сети;
	# per-client классы пересобираются при изменении списка клиентов
	local clients=""
	if [ "$want" = "1" ] && [ "$(uciget "$CFG.config.limit_enabled")" = "1" ]; then
		local sig last
		sig=$(shaper_sig)
		last=$(cat /var/run/guestwifi.sig 2>/dev/null)
		if [ "$sig" != "$last" ]; then
			shaper_apply
			echo "$sig" > /var/run/guestwifi.sig 2>/dev/null
		fi
		[ "$(bg_rate "$(uciget "$CFG.config.limit_per")")" -gt 0 ] && \
			clients=$(guest_leases | grep -c .)
	else
		if shaper_running; then
			shaper_clear
		fi
		rm -f /var/run/guestwifi.sig 2>/dev/null
	fi

	# доступ гостей к самому роутеру (firewall zone input)
	fw_sync

	# persist relevant tx state
	{
		echo "on=$cur_on"
		echo "ssid=$ssid"
	} > "$STATE"

	write_status "$cur_on" "$want" "$clients"
}

do_status() {
	[ -f "$STATUS" ] && { cat "$STATUS"; echo; return; }
	do_check
}

do_on()  { uci set "$CFG.config.enabled=1"; uci commit "$CFG"; do_check; }
do_off() { uci set "$CFG.config.enabled=0"; uci commit "$CFG"; do_check; }

do_help() {
	echo "Usage: guestwifi {check|status|on|off}"
}

case "${1:-check}" in
	check)  do_check ;;
	status) do_status ;;
	on)     do_on ;;
	off)    do_off ;;
	*)      do_help ;;
esac
